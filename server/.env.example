# Configuración del servidor
PORT=3001

# Google OAuth 2.0 (Obtenidos de Google Cloud Console)
# Nota: También se pueden ingresar dinámicamente desde la interfaz web.
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# (Opcional - Recomendado para Vercel Serverless)
# Base de datos en la nube para sincronización multi-dispositivo permanente:
# Opción A: Vercel KV (Integración nativa de 1 clic en Vercel Storage)
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# Opción B: Upstash Redis (100% gratuito)
# UPSTASH_REDIS_REST_URL=https://tu-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=tu_token_aqui
